shown.","ID":"NO_d6EyhGRjeGBVsNg","UserID":"UR_6KACh5YeBYAQwaq","Timestamp":1784516285,"Removed":true}],"UserStatuses":{"UR_6KACh5YeBYAQwaq":"Expanded"},"ParentID":"QID8","ID":"NT_bDRwytlecLA6LIi"}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"c6241e1e-a077-400a-b0e9-d87d49fd6e98"}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"10","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"RS","PrimaryAttribute":"RS_823vcMXDfQzJ1JQ","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":"","PreviousButton":"","NextButton":"","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"mit","SkinType":"component","Skin":{"brandingId":null,"templateId":"*simple","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today."}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"In the example above, you should focus only on whether the final word library is a natural interp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">In the example above, you should focus only on whether the final word <strong>library<\/strong> is a natural interpretation of the picture. <\/span><\/span>\n<ul>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">You should not judge whether the picture proves that the person is a &quot;she&quot;,&nbsp;or whether she &quot;needed&quot; to do something. <\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">Treat the rest of the sentence as given;&nbsp;judge only whether the sentence ending fits the situation shown.<\/span><\/span><\/li>\n<\/ul>\n<br \/>\n<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">When you are ready, click <strong>next<\/strong> to begin the experiment.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q10","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the example above, you should focus only on whether the final word library is a natural interp...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Picture-Sentence Compatibility Ratings Thank you for taking part in this study! In this experimen...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:19px;\"><strong>Picture-Sentence Compatibility Ratings <\/strong><\/span><\/span><\/h1>\n\n<p><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">Thank you for taking part in this study!<br>\n<br>\nIn this experiment, you will view a series of pictures paired with sentences. Your task is to judge <strong>how well the final word of each sentence fits the situation shown in the picture. <\/strong><br>\n<br>\nThe survey contains 80 picture-sentence pairs and should take approximately 10-15 minutes to complete.<br>\n<br>\nThere are no right or wrong answers. We are interested in your own judgments. Please answer each question based on your first impression, and avoid spending too much time on any one item.<br>\n<br>\nClick&nbsp;<strong>next<\/strong> to see detailed instructions.<\/span><\/span><\/p>","DefaultChoices":false,"DataExportTag":"Q5","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Picture-Sentence Compatibility Ratings Thank you for taking part in this study! In this experimen...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Instructions For each question, you will see: one picture one sentence ending in a critical final...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><span style=\"font-family:Georgia,serif;\"><strong><span style=\"font-size:19px;\">Instructions<\/span><\/strong><\/span><\/h1>\n\n<p><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">For each question, you will see: <\/span><\/span><\/p>\n\n<ul>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">one picture <\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">one sentence ending in a critical final word<\/span><\/span><\/li>\n<\/ul>\n<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">Y<\/span><span style=\"font-size:16px;\">our task is to judge <strong>how compatible the sentence's final word is with the situation shown in the picture<\/strong>.<br>\n<br>\nWhen making your judgment: <\/span><\/span>\n\n<ul>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>Focus on the final word of the sentence. <\/strong>Treat the rest of the sentence as given. <\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">The picture does <strong>not<\/strong> need to prove that the sentence ending is the only possible interpretation. Simply, decide whether the final word is a <strong>natural and reasonable<\/strong> interpretation of the picture. <\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">Please rely on your immediate, common-sense impression rather than overthinking each item. <\/span><\/span><\/li>\n<\/ul>\n<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">Use the following rating scale:<\/span><\/span>\n\n<ol>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>Not compatible at all.&nbsp;<\/strong>The final word is clearly inconsistent with \/ unrelated to \/ contradicts the picture.<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>Low compatibility.&nbsp;<\/strong>The final word is technically plausible but would not be commonly associated with the picture \/ it would be unusual or difficult to reconcile this sentence with the picture.<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>Uncertain.<\/strong>&nbsp;The final word provides weak \/ ambiguous \/ mixed evidence for the picture.<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>Compatible.<\/strong>&nbsp;The final word makes the sentence a reasonable interpretation of the picture.<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>Very compatible.<\/strong>&nbsp;The final word makes the sentence very consistent with \/ a natural interpretation of the picture.<\/span><\/span><\/li>\n<\/ol>\n<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">The following is an example of the type of questions on this survey.&nbsp;<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q6","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions For each question, you will see: one picture one sentence ending in a critical final...","ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Sentence She needed to put everything in the library.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:Georgia,serif;\"><img height=\"512\" src=\"https:\/\/mit.co1.qualtrics.com\/CP\/Graphic.php?IM=IM_VzafRSjErA3JC6k\" style=\"width: 512px; height: 512px;\" width=\"512\" \/><\/span><\/span>\n<p data-end=\"2335\" data-start=\"2323\"><span style=\"font-size:16px;\"><span style=\"font-family:Georgia,serif;\"><strong data-end=\"2335\" data-start=\"2323\">Sentence<\/strong><\/span><\/span><\/p>\n\n<blockquote data-end=\"2387\" data-start=\"2337\">\n<p data-end=\"2387\" data-start=\"2339\"><span style=\"font-size:16px;\"><span style=\"font-family:Georgia,serif;\">She needed to put everything in the <strong data-end=\"2386\" data-start=\"2375\">library<\/strong>.<\/span><\/span><\/p>\n<\/blockquote>","DefaultChoices":false,"DataExportTag":"Q8","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Sentence She needed to put everything in the library.","Choices":{"1":{"Display":"<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>1 = Not compatible at all. <\/strong>The final word is clearly inconsistent with \/ unrelated to \/ contradicts the picture.<\/span><\/span>"},"2":{"Display":"<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>2 = Low compatibility. <\/strong>The final word is technically plausible but would not be commonly associated with the picture \/ it would be unusual or difficult to reconcile this sentence with the picture.<\/span><\/span>"},"3":{"Display":"<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>3 = Uncertain. <\/strong>The final word provides weak \/ ambiguous \/ mixed evidence for the picture.<\/span><\/span>"},"4":{"Display":"<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\"><strong>4 = Compatible. <\/strong>The final word makes the sentence a reasonable interpretation of the picture.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:Georgia,serif;\"><strong>5 = Very compatible. <\/strong>The final word makes the sentence very consistent with \/ a natural interpretation of the picture.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID8"}},{"SurveyID":"SV_1XjcaO5KN7i7iBw","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}