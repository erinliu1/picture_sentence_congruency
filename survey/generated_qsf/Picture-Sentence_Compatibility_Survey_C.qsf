    {
      "SurveyID": "SV_d7qMiMtKwcN5RL8",
      "Element": "SQ",
      "PrimaryAttribute": "QID5",
      "SecondaryAttribute": "Picture-Sentence Compatibility Ratings Thank you for taking part in this study! In this experimen...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h1><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:19px;\"><strong>Picture-Sentence Compatibility Ratings </strong></span></span></h1>\n\n<p><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">Thank you for taking part in this study!<br>\n<br>\nIn this experiment, you will view a series of pictures paired with sentences. Your task is to judge <strong>how well the final word of each sentence fits the situation shown in the picture. </strong><br>\n<br>\nThe survey contains 80 picture-sentence pairs and should take approximately 10-15 minutes to complete.<br>\n<br>\nThere are no right or wrong answers. We are interested in your own judgments. Please answer each question based on your first impression, and avoid spending too much time on any one item.<br>\n<br>\nClick&nbsp;<strong>next</strong> to see detailed instructions.</span></span></p>",
        "DefaultChoices": false,
        "DataExportTag": "Q5",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
