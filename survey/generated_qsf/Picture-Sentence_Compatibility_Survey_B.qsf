    {
      "SurveyID": "SV_d7qMiMtKwcN5RL8",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "In this study, you will see a series of pictures paired with sentences. Your task is to judge how...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "In this study, you will see a series of pictures paired with sentences. Your task is to judge how compatible the final word of the sentence is with the situation shown in the picture. When making your judgment: Focus on the final word of the sentence. Treat the rest of the sentence as given. Base your judgment on what is shown in the picture and what would naturally make sense in that situation. You may consider the people, objects, actions, setting, facial expressions, and body language shown in the picture, as long as your judgment is based on what is visibly present. The picture does not need to prove that the sentence ending is the only possible interpretation. Instead, decide whether the final word is a natural and reasonable way to complete the sentence given the picture. Please rely on your immediate, common-sense impression rather than overanalyzing each item. Use the following scale: 1 &ndash; Not compatible at all The final word is clearly inconsistent with or unrelated to the picture. 2 &ndash; Slightly compatible The final word is possible, but it would be an unusual interpretation of the picture. 3 &ndash; Moderately compatible The picture provides mixed or ambiguous support for the final word. 4 &ndash; Compatible The final word is a reasonable interpretation of the picture. 5 &ndash; Very compatible The final word is a natural and highly compatible interpretation of the picture. There are no right or wrong answers. We are interested in your own judgment.",
        "DataExportTag": "Q1",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "In this study, you will see a series of pictures paired with sentences. Your task is to judge how...",
        "Choices": {
          "1": {
            "Display": "Click to write Choice 1"
          },
          "2": {
            "Display": "Click to write Choice 2"
          },
          "3": {
            "Display": "Click to write Choice 3"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "OFF",
            "Type": "None"
          }
        },
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionID": "QID1"
      }
    },
    {
      "SurveyID": "SV_d7qMiMtKwcN5RL8",
      "Element": "SQ",
      "PrimaryAttribute": "QID10",
      "SecondaryAttribute": "In the example above, you should focus only on whether the final word library is a natural interp...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">In the example above, you should focus only on whether the final word <strong>library</strong> is a natural interpretation of the picture. </span></span>\n<ul>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">You should not judge whether the picture proves that the person is a &quot;she&quot;,&nbsp;or whether she &quot;needed&quot; to do something. </span></span></li>\n\t<li><span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">Treat the rest of the sentence as given;&nbsp;judge only whether the sentence ending fits the situation shown.</span></span></li>\n</ul>\n<br />\n<span style=\"font-family:Georgia,serif;\"><span style=\"font-size:16px;\">When you are ready, click <strong>next</strong> to begin the experiment.</span></span>",
        "DefaultChoices": false,
        "DataExportTag": "Q10",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "In the example above, you should focus only on whether the final word library is a natural interp...",
